{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HALO",
  "version": "1.0.0",
  "identifier": "com.sharique.halo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "HALO",
        "url": "index.html",
        "width": 1100,
        "height": 700,
        "minWidth": 900,
        "minHeight": 600
      },
      {
        "label": "search-overlay",
        "title": "HALO Search",
        "url": "/search-overlay.html",
        "width": 660,
        "height": 420,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true,
        "skipTaskbar": true,
        "shadow": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
